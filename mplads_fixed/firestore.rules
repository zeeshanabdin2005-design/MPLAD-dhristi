rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isOwner() { return isSignedIn() && resource.data.uploadedByUid == request.auth.uid; }
    function keepsOwner() { return request.resource.data.uploadedByUid == resource.data.uploadedByUid; }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /documents/{documentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.processingStatus == 'PENDING'
        && request.resource.data.uploadedByUid == request.auth.uid;
      allow update: if (
        isOwner() && keepsOwner()
        && resource.data.processingStatus == 'PENDING'
        && request.resource.data.processingStatus == 'PROCESSING'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['processingStatus'])
      ) || (
        isOwner() && keepsOwner()
        && resource.data.processingStatus == 'PROCESSING'
        && request.resource.data.processingStatus in ['COMPLETED', 'FAILED']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'processingStatus', 'ocrStatus', 'aiStatus', 'model', 'processedAt',
          'extractedFields', 'observations', 'evidenceSignals', 'processingError'
        ])
      );
      allow delete: if isOwner();
    }

    match /images/{imageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.processingStatus == 'PENDING'
        && request.resource.data.uploadedByUid == request.auth.uid;
      allow update: if (
        isOwner() && keepsOwner()
        && resource.data.processingStatus == 'PENDING'
        && request.resource.data.processingStatus == 'PROCESSING'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['processingStatus'])
      ) || (
        isOwner() && keepsOwner()
        && resource.data.processingStatus == 'PROCESSING'
        && request.resource.data.processingStatus in ['COMPLETED', 'FAILED']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'processingStatus', 'aiStatus', 'model', 'processedAt', 'observations',
          'sceneDescription', 'visibleWorkStage', 'visibleText', 'confidence',
          'evidenceSignals', 'processingError'
        ])
      );
      allow delete: if isOwner();
    }

    match /verificationCases/{caseId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /riskAssessments/{projectId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
